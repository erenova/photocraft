+    let (offer, params) = growing_offer(&s, &gate);
+    let steps = s.active().unwrap().history.past_len();
+    s.offer_live_quick(offer);
+    let crate::jobs::Started::Job(job) = s.start("select.quick", params).unwrap() else { panic!("a job") };
