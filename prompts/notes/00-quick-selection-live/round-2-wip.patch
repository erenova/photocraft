+fn control_requests_while_a_stroke_commits_get_real_replies_through_the_gate() {
+    // Review of #9145: a command deferred behind a stroke replied `{"pending": true}` (even
+    // `engine.commands`), lost its errors and later ran without the automation gate.
+    fn deny_new_layer(id: &str, _: &Value) -> photocraft_engine::Result<()> {
+        if id == "layer.new.layer" { Err(photocraft_engine::EngineError::Other("layer.new.layer is denied (test)".into())) } else { Ok(()) }
+    }
+    let services = crate::Services {
+        automation_command: Some(Box::new(|id, _| if id == "layer.new.layer" { Err("layer.new.layer is denied (test)".into()) } else { Ok(()) })),
+        automation_authorize: Some(deny_new_layer),
+        ..Default::default()
+    };
+    let mut app = quick_app();
+    app.services = services;
+    app.session.actions.list.push(photocraft_engine::actions_cmds::Action {
+        name: "Add".into(),
+        steps: vec![("layer.new.layer".into(), json!({}))],
+        ..Default::default()
+    });
+    let ctx = egui::Context::default();
+    let call = |app: &mut PhotocraftApp, method: &str, params: Value| -> Value {
+        let (req, _rx) = crate::control::ControlRequest::new(method, params);
+        match crate::control::handle(app, &ctx, &req) {
+            crate::control::Outcome::Done(v) => v,
+            _ => panic!("{method}: expected an immediate reply"),
+        }
+    };
+    let layers = |app: &PhotocraftApp| app.session.active().unwrap().doc.layers.len();
+    let n0 = layers(&app);
+    let gate = Arc::new(std::sync::RwLock::new(()));
+    let held = gate.write().unwrap();
+    released_stroke_held(&mut app, &gate);
+    let play = call(&mut app, "engine.execute", json!({"command": "actions.play", "params": {"action": "Add"}}));
+    let bad = call(&mut app, "engine.execute", json!({"command": "select.quick", "params": {"points": []}}));
+    let list = call(&mut app, "engine.commands", json!({}));
+    let all = call(&mut app, "engine.execute", json!({"command": "select.all", "params": {}}));
+    for (what, r) in [("bad params", &bad), ("select.all", &all)] {
+        assert_eq!(r["ok"], false, "{what}: {r}");
+    }
+    // The play ran nothing: its step was refused by the gate, and says so.
+    assert_eq!(play["result"]["ran"], 0, "{play}");
+    assert!(play["result"]["failed"]["error"].as_str().is_some_and(|e| e.contains("denied")), "{play}");
+    for r in [&play, &bad, &list, &all] {
+        assert!(r.get("result").and_then(|v| v.get("pending")).is_none(), "{r}");
+    }
+    assert!(all["error"].as_str().is_some_and(|e| e.contains("still running")), "{all}");
+    assert!(list["result"].is_array(), "engine.commands lists the commands: {list}");
+    drop(held);
+    settle(&mut app);
+    assert!(idle(&app));
+    assert_eq!(layers(&app), n0, "the denied step never ran, then or later");
+    assert!(doc_selection(&app).is_some_and(|s| s.sample_channel(180, 300, 0) >= 0.5), "the stroke is committed");
+}
