+#[test]
+fn a_selection_edit_keeps_the_pixels_a_stroke_reads() {
+    let mut s = two_regions(8);
+    let p = json!({"size": 8});
+    let before = QuickSource::new(&s, &p).unwrap();
+    assert!(before.reads(s.active().unwrap()));
+    s.execute("select.all", json!({})).unwrap();
+    let after = QuickSource::new(&s, &p).unwrap();
+    assert!(!before.reads(s.active().unwrap()), "an edit makes a new document");
+    assert!(before.same_pixels(&after), "Select All left the pixels alone");
+    assert!(!before.same_pixels(&QuickSource::new(&s, &json!({"size": 9})).unwrap()), "another brush grows other regions");
+    assert!(!before.same_pixels(&QuickSource::new(&s, &json!({"size": 8, "sampleAllLayers": true})).unwrap()));
+    s.edit("paint", |doc, _| {
+        doc.layers[0].surface_mut().unwrap().fill_rect(Rect::new(0, 0, 10, 10), &[1.0, 0.0, 0.0, 1.0]);
+        Ok(())
+    })
+    .unwrap();
+    let painted = QuickSource::new(&s, &p).unwrap();
+    assert!(!after.same_pixels(&painted), "painted pixels grow other regions");
+    assert_eq!(QuickSource::on(&s, painted.doc(), &p).unwrap().doc(), painted.doc());
+}
