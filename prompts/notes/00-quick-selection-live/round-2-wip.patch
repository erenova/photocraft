+#[test]
+fn cancelling_a_released_stroke_leaves_the_document_alone() {
+    let mut app = quick_app();
+    let gate = Arc::new(std::sync::RwLock::new(()));
+    let held = gate.write().unwrap();
+    let steps = app.session.active().unwrap().history.past_len();
+    let job = released_stroke_held(&mut app, &gate);
+    // What Esc (or the status bar's ×) does for the job in view.
+    assert_eq!(crate::jobs_ui::job_in_view(&app).map(|j| j.id), Some(job));
+    assert!(crate::jobs_ui::cancel(&mut app, job));
+    drop(held);
+    settle(&mut app);
+    crate::jobs_ui::tick(&mut app, &egui::Context::default());
+    assert!(idle(&app));
+    assert_eq!(doc_selection(&app), None);
+    assert_eq!(app.session.active().unwrap().history.past_len(), steps);
+    assert!(app.session.journal.iter().all(|(id, _)| id != "select.quick"));
+    assert!(app.ui.status.contains("Cancelled"), "{}", app.ui.status);
+    assert!(app.run("select.all", json!({})).is_ok(), "the document is free again");
+}
