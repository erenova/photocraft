+#[test]
+fn a_stroke_released_on_another_tab_commits_on_its_own_document() {
+    let mut app = quick_app();
+    let doc_a = app.session.active().unwrap().doc.id;
+    app.session.execute("file.new", json!({"width": 300, "height": 200})).unwrap();
+    app.session.set_active(0);
+    down(&mut app, 100.0, 300.0, Modifiers::NONE);
+    drag(&mut app, 160.0, 300.0, Modifiers::NONE);
+    // The other tab comes to the front before the button goes up.
+    app.session.set_active(1);
+    up(&mut app, 200.0, 300.0, Modifiers::NONE);
+    assert!(idle(&app));
+    assert_eq!(app.session.active_index(), Some(1));
+    assert!(app.session.active().unwrap().doc.selection.is_none());
+    let a = app.session.documents().iter().find(|st| st.doc.id == doc_a).unwrap();
+    assert!(a.doc.selection.as_ref().is_some_and(|s| s.sample_channel(150, 300, 0) >= 0.5));
+}
