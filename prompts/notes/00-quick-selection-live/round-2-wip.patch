diff --git a/crates/ui-egui/src/quick_select_ui/worker.rs b/crates/ui-egui/src/quick_select_ui/worker.rs
new file mode 100644
index 00000000..4b8d5692
--- /dev/null
+++ b/crates/ui-egui/src/quick_select_ui/worker.rs
@@ -0,0 +1,373 @@
+//! A Quick Selection stroke's worker thread (desktop): it plans the segments sent to it in order,
+//! grows their regions at once on the Quick Selection thread pool, combines them in order as they
+//! come back (so the result is the one growing them one after another makes), traces the new
+//! outline, and hands the stroke back after each change. A base it has left (the document
+//! changed under the stroke) is dropped at once: regions still queued for it are skipped.
+
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::mpsc::{Receiver, RecvTimeoutError, Sender, TryRecvError, channel};
+use std::time::Duration;
+
+use photocraft_algo::segment::quick::SPECULATE_DEFAULT;
+use photocraft_algo::selection::{Region, SelectionMode};
+use photocraft_engine::EngineError;
+use photocraft_engine::quick_stroke::{Finish, QuickSource, QuickStroke};
+
+use super::{Handed, OutlineView, Preview, bounds, failed_message, pool};
+
+/// Work for a stroke's worker.
+pub(crate) enum Task {
+    /// Start (again) from `stroke` on `src`: the stroke began, or was rebased. With
+    /// `keep_regions` the pixels are the ones the regions grown so far were grown on.
+    Reset { generation: u64, src: QuickSource, stroke: QuickStroke, keep_regions: bool },
+    /// Grow the next segment, and trace the outline for `view`.
+    Grow { generation: u64, pts: Vec<(f32, f32)>, mode: SelectionMode, view: Option<OutlineView> },
+}
+
+/// What a worker hands back.
+pub(crate) enum Back {
+    /// The stroke after a change, combined on base `generation`, and its preview.
+    Grown { generation: u64, stroke: Box<QuickStroke>, preview: Preview },
+    /// Growing on base `generation` failed (an internal error): it grows nothing more of it.
+    Failed { generation: u64 },
+}
+
+/// Most regions kept for a rebase that leaves the pixels alone (a long stroke's first ones).
+const CACHED: usize = 1024;
+
+/// What the worker thread receives: tasks from the stroke, regions from the pool, or the end.
+enum Msg {
+    Task(Task),
+    /// Segment `index`'s region grown from `line` on pixels `pixels` (`None`: skipped, not wanted
+    /// any more when its turn came).
+    Region {
+        pixels: u64,
+        index: usize,
+        line: Vec<(f32, f32)>,
+        region: Option<std::thread::Result<Option<Region>>>,
+    },
+    Stop,
+}
+
+/// Test hooks a worker honours: a lock each region takes before growing, failing, and a count of
+/// the regions it grew.
+#[cfg(test)]
+pub(crate) type Hooks = (Option<Arc<std::sync::RwLock<()>>>, bool, Arc<std::sync::atomic::AtomicUsize>);
+
+/// A stroke's worker thread. Dropping it stops the thread and skips the regions still queued.
+pub(crate) struct Worker {
+    tx: Sender<Msg>,
+    rx: Receiver<Back>,
+    /// The pixels the stroke reads (bumped by every rebase that changed them): a region queued
+    /// for others is skipped.
+    current: Arc<AtomicU64>,
+    /// The stroke is gone (or its commit was cancelled): skip everything queued.
+    stop: Arc<AtomicBool>,
+    /// The thread is running.
+    alive: Arc<AtomicBool>,
+}
+
+/// Marks the worker thread as ended however it ends.
+struct Alive(Arc<AtomicBool>);
+
+impl Drop for Alive {
+    fn drop(&mut self) {
+        self.0.store(false, Ordering::Relaxed);
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        let _ = self.tx.send(Msg::Stop);
+    }
+}
+
+impl Worker {
+    /// Start a worker; `None` when no thread can be had (the segments then grow inline).
+    pub(crate) fn start(ctx: Option<egui::Context>, #[cfg(test)] hooks: Hooks) -> Option<Self> {
+        let (tx, msgs) = channel::<Msg>();
+        let (done, rx) = channel::<Back>();
+        let current = Arc::new(AtomicU64::new(0));
+        let stop = Arc::new(AtomicBool::new(false));
+        let alive = Arc::new(AtomicBool::new(true));
+        let thread = Thread {
+            regions: tx.clone(),
+            done,
+            current: Arc::clone(&current),
+            stop: Arc::clone(&stop),
+            ctx,
+            #[cfg(test)]
+            hooks,
+            state: None,
+            pixels: 0,
+            cache: BTreeMap::new(),
+            growing: BTreeMap::new(),
+        };
+        let marker = Alive(Arc::clone(&alive));
+        std::thread::Builder::new()
+            .name("quick-selection".into())
+            .spawn(move || {
+                let _alive = marker;
+                thread.run(&msgs);
+            })
+            .ok()?;
+        Some(Self { tx, rx, current, stop, alive })
+    }
+
+    /// A worker with no thread, and the sender of what it hands back (tests).
+    #[cfg(test)]
+    pub(crate) fn detached() -> (Self, Sender<Back>) {
+        let (tx, _msgs) = channel::<Msg>();
+        let (done, rx) = channel::<Back>();
+        let flag = || Arc::new(AtomicBool::new(false));
+        (Self { tx, rx, current: Arc::new(AtomicU64::new(0)), stop: flag(), alive: Arc::new(AtomicBool::new(true)) }, done)
+    }
+
+    /// Send `task`; false when the thread is gone.
+    pub(crate) fn send(&self, task: Task) -> bool {
+        if let Task::Reset { keep_regions: false, .. } = &task {
+            // New pixels (the thread counts them the same way): regions still queued for the
+            // old ones are skipped from now on, before the thread reads this.
+            self.current.fetch_add(1, Ordering::Relaxed);
+        }
+        self.tx.send(Msg::Task(task)).is_ok()
+    }
+
+    /// The next thing handed back, waiting for it; `None` when the thread is gone.
+    pub(crate) fn recv(&self) -> Option<Back> {
+        self.rx.recv().ok()
+    }
+
+    /// The next thing handed back, if any.
+    pub(crate) fn try_recv(&self) -> Option<Back> {
+        self.rx.try_recv().ok()
+    }
+
+    /// The thread has ended (it failed, or was stopped).
+    pub(crate) fn gone(&self) -> bool {
+        !self.alive.load(Ordering::Relaxed)
+    }
+
+    /// How `select.quick` gets the stroke once the worker has combined all `total` segments on
+    /// base `generation` (everything it hands back meanwhile goes to `handed`, for the canvas).
+    /// Cancelling the job stops the worker.
+    pub(crate) fn finish(self, generation: u64, total: usize, handed: Handed) -> Finish {
+        Box::new(move |ctx| {
+            loop {
+                if ctx.cancelled() {
+                    return Err(EngineError::Cancelled);
+                }
+                match self.rx.recv_timeout(Duration::from_millis(10)) {
+                    Ok(Back::Grown { generation: g, stroke, preview }) if g == generation => {
+                        ctx.progress(stroke.combined() as f32 / total.max(1) as f32, "Selecting");
+                        let whole = stroke.combined() >= total;
+                        *handed.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Some(preview);
+                        if whole {
+                            return Ok(*stroke);
+                        }
+                    }
+                    Ok(Back::Failed { generation: g }) if g == generation => return Err(EngineError::Other(failed_message())),
+                    Ok(_) | Err(RecvTimeoutError::Timeout) => {}
+                    Err(RecvTimeoutError::Disconnected) => return Err(EngineError::Other(failed_message())),
+                }
+            }
+        })
+    }
+}
+
+/// A region grown from a polyline (`None`: it found nothing).
+type Grown = (Vec<(f32, f32)>, Option<Region>);
+
+/// A base's segments on the worker thread.
+struct Base {
+    generation: u64,
+    src: Arc<QuickSource>,
+    stroke: QuickStroke,
+    /// Each planned segment's polyline and mode, by index (combined in this order).
+    planned: Vec<(Vec<(f32, f32)>, SelectionMode)>,
+    /// Regions grown and not combined yet, by index.
+    arrived: BTreeMap<usize, Option<Region>>,
+    view: Option<OutlineView>,
+}
+
+/// The worker thread's state.
+struct Thread {
+    /// Where pool tasks send the regions they grew.
+    regions: Sender<Msg>,
+    done: Sender<Back>,
+    /// The pixels the stroke reads, as the stroke last set them (see [`Thread::pixels`]).
+    current: Arc<AtomicU64>,
+    stop: Arc<AtomicBool>,
+    ctx: Option<egui::Context>,
+    #[cfg(test)]
+    hooks: Hooks,
+    state: Option<Base>,
+    /// The pixels the stroke reads: bumped by a rebase that changed them. A region grown on them
+    /// is the segment's on any base with these pixels (an edit of the selection only rebases).
+    pixels: u64,
+    /// Regions grown on these pixels, by segment index with the line they grew from.
+    cache: BTreeMap<usize, Grown>,
+    /// Regions growing on these pixels, by segment index with their line.
+    growing: BTreeMap<usize, Vec<(f32, f32)>>,
+}
+
+impl Thread {
+    fn run(mut self, msgs: &Receiver<Msg>) {
+        while let Ok(first) = msgs.recv() {
+            let mut next = Some(first);
+            let mut failed = false;
+            while let Some(msg) = next.take() {
+                match msg {
+                    Msg::Stop => return,
+                    Msg::Task(task) => self.task(task),
+                    Msg::Region { pixels, index, line, region } => failed |= self.arrived(pixels, index, line, region),
+                }
+                // Everything that has come, before combining.
+                next = match msgs.try_recv() {
+                    Ok(m) => Some(m),
+                    Err(TryRecvError::Empty) => None,
+                    Err(TryRecvError::Disconnected) => return,
+                };
+            }
+            if self.stop.load(Ordering::Relaxed) {
+                return;
+            }
+            if !failed {
+                failed = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| self.combine())).is_err();
+            }
+            if failed {
+                let generation = self.state.take().map_or(0, |b| b.generation);
+                self.cache.clear();
+                self.growing.clear();
+                if self.done.send(Back::Failed { generation }).is_err() {
+                    return;
+                }
+                self.wake();
+            }
+        }
+    }
+
+    fn wake(&self) {
+        if let Some(ctx) = &self.ctx {
+            ctx.request_repaint();
+        }
+    }
+
+    /// A region came back. True when growing it failed for the current base.
+    fn arrived(&mut self, pixels: u64, index: usize, line: Vec<(f32, f32)>, region: Option<std::thread::Result<Option<Region>>>) -> bool {
+        // Grown on pixels the stroke no longer reads: nothing to do with it.
+        if pixels != self.pixels {
+            return false;
+        }
+        if self.growing.get(&index) == Some(&line) {
+            self.growing.remove(&index);
+        }
+        let wanted = self.state.as_ref().is_some_and(|b| index >= b.stroke.combined() && b.planned.get(index).is_some_and(|(l, _)| *l == line));
+        match region {
+            // Skipped (the worker is stopping): nothing grown.
+            None => false,
+            Some(Ok(region)) => {
+                if self.cache.len() < CACHED || self.cache.contains_key(&index) {
+                    self.cache.insert(index, (line, region.clone()));
+                }
+                if let Some(base) = self.state.as_mut().filter(|_| wanted) {
+                    base.arrived.insert(index, region);
+                }
+                false
+            }
+            Some(Err(_)) => wanted,
+        }
+    }
+
+    fn task(&mut self, task: Task) {
+        match task {
+            Task::Reset { generation, src, stroke, keep_regions } => {
+                if !keep_regions {
+                    self.cache.clear();
+                    self.growing.clear();
+                    self.pixels += 1;
+                }
+                self.state = Some(Base { generation, src: Arc::new(src), stroke, planned: Vec::new(), arrived: BTreeMap::new(), view: None });
+            }
+            Task::Grow { generation, pts, mode, view } => {
+                let Some(base) = self.state.as_mut().filter(|b| b.generation == generation) else { return };
+                base.view = view;
+                let index = base.planned.len();
+                let Some(planned) = base.stroke.plan(&base.src, &pts, mode) else { return };
+                base.planned.push((planned.line.clone(), planned.mode));
+                // Grown already on these pixels from this very line (a rebase kept them), or
+                // growing: it is the segment's region here too.
+                if let Some((line, region)) = self.cache.get(&index)
+                    && *line == planned.line
+                {
+                    base.arrived.insert(index, region.clone());
+                    return;
+                }
+                if self.growing.get(&index) == Some(&planned.line) {
+                    return;
+                }
+                // Alone, a segment cuts a few window sizes at once to be back sooner; behind
+                // others, one at a time, so no thread cuts windows that turn out unneeded.
+                let waiting = index.saturating_sub(base.stroke.combined());
+                let speculate = if waiting == 0 { SPECULATE_DEFAULT } else { 1 };
+                self.growing.insert(index, planned.line.clone());
+                let (src, tx, current, stop, pixels) =
+                    (Arc::clone(&base.src), self.regions.clone(), Arc::clone(&self.current), Arc::clone(&self.stop), self.pixels);
+                #[cfg(test)]
+                let hooks = self.hooks.clone();
+                let grow = move || {
+                    #[cfg(test)]
+                    let _held = hooks.0.as_ref().map(|g| g.read().unwrap_or_else(std::sync::PoisonError::into_inner));
+                    let line = planned.line;
+                    // The stroke went, or its pixels changed: not wanted any more.
+                    let region = if stop.load(Ordering::Relaxed) || current.load(Ordering::Relaxed) != pixels {
+                        None
+                    } else {
+                        Some(std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                            #[cfg(test)]
+                            {
+                                if hooks.1 {
+                                    std::panic::resume_unwind(Box::new("a failing worker (test)"));
+                                }
+                                hooks.2.fetch_add(1, Ordering::Relaxed);
+                            }
+                            src.region_speculating(&line, speculate)
+                        })))
+                    };
+                    let _ = tx.send(Msg::Region { pixels, index, line, region });
+                };
+                match pool() {
+                    Some(pool) => pool.spawn(grow),
+                    None => grow(),
+                }
+            }
+        }
+    }
+
+    /// Combine the regions that have come, in order; when that changed the stroke, trace its
+    /// outline and hand it back.
+    fn combine(&mut self) {
+        let Some(base) = self.state.as_mut() else { return };
+        let before = base.stroke.combined();
+        while let Some(region) = base.arrived.remove(&base.stroke.combined()) {
+            let mode = base.planned.get(base.stroke.combined()).map_or(SelectionMode::Add, |p| p.1);
+            base.stroke.apply(mode, region);
+        }
+        if base.stroke.combined() == before {
+            return;
+        }
+        // Traced here, on one thread: the pool is busy growing, and the UI's is the UI's.
+        let bounds = bounds(&base.stroke);
+        let outline = base.view.zip(base.stroke.selection()).map(|(v, sel)| {
+            let segs = crate::outline::outline_scaled_serial(sel, bounds.intersect(&v.vis), v.step);
+            (v.doc, crate::canvas::outline_key(sel, v.step, v.doc, v.vis, 1), Arc::new(segs))
+        });
+        let sel = base.stroke.selection().cloned().map(Arc::new);
+        let back = Back::Grown { generation: base.generation, stroke: Box::new(base.stroke.clone()), preview: Preview { sel, bounds, outline } };
+        let _ = self.done.send(back);
+        self.wake();
+    }
+}
