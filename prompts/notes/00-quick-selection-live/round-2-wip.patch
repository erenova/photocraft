+#[test]
+fn a_running_job_refuses_every_command_that_makes_a_history_step_on_its_document() {
+    // Guides, slices, the ruler origin and a gradient preset applied as a fill layer are steps in
+    // the document's history: run under a job, they would land before its result and ⌘Z would
+    // take back the job instead of them (#9145).
+    let mut s = session(64, 64);
+    let gate = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let id = gated_job(&mut s, &gate);
+    let steps = s.active().unwrap().history.past_len();
+    for (cmd, p) in [
+        ("view.newGuide", json!({"orientation": "vertical", "position": 40})),
+        ("view.clearGuides", json!({})),
+        ("view.setRulerOrigin", json!({"x": 4, "y": 4})),
+        ("gradient.presets.apply", json!({"angle": 0})),
+    ] {
+        let err = s.execute(cmd, p).unwrap_err();
+        assert!(matches!(&err, EngineError::Disabled(_, why) if why.contains("Gated Job")), "{cmd}: {err}");
+    }
+    assert_eq!(s.active().unwrap().history.past_len(), steps, "nothing ran");
+    // Brush, colours and presets aren't the document's: they still change.
+    s.execute("tools.setBrush", json!({"size": 12})).unwrap();
+    s.execute("tools.swapColors", json!({})).unwrap();
+    gate.store(true, std::sync::atomic::Ordering::Relaxed);
+    assert!(matches!(wait_event(&mut s, id).outcome, JobOutcome::Done(_)));
+    s.execute("view.newGuide", json!({"orientation": "vertical", "position": 40})).unwrap();
+}
