+/// A growing offer for `s`'s stroke `CUT`: its first segment grown, the others planned; `finish`
+/// grows them once `gate` opens, unless cancelled first. Returns the offer and `select.quick`'s
+/// params for it.
+fn growing_offer(s: &Session, gate: &Arc<std::sync::atomic::AtomicBool>) -> (QuickCommit, Value) {
+    let src = QuickSource::new(s, &json!({"size": 8})).unwrap();
+    let mut live = QuickStroke::new(src.selection().cloned());
+    live.push(&src, CUT[0].0, CUT[0].1);
+    let planned: Vec<Planned> = CUT[1..].iter().filter_map(|(pts, m)| live.plan(&src, pts, *m)).collect();
+    let mut params = live.params();
+    params["size"] = json!(8);
+    let (points, segments) = (live.points().to_vec(), live.segments().to_vec());
+    let (gate, grows) = (gate.clone(), src.clone());
+    let finish: Finish = Box::new(move |ctx: &crate::jobs::JobCtx| {
+        while !gate.load(std::sync::atomic::Ordering::Relaxed) {
+            ctx.check()?;
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        for p in planned {
+            let region = grows.region(&p.line);
+            live.apply(p.mode, region);
+        }
+        Ok(live)
+    });
+    (QuickCommit::growing(src, points, segments, finish), params)
+}
