+/// Journaled commands that never edit a document, allowed while a job runs on the active one
+/// (queries and view state, which aren't journaled, always are). Every other journaled command may
+/// make a history step on it, so it waits: guides, slices and the ruler origin (`view.newGuide`…)
+/// and a gradient preset applied as a fill layer (`gradient.presets.apply`) are document edits.
+fn independent_of_document(id: &str) -> bool {
+    const PREFIXES: &[&str] = &["jobs.", "tools.", "window.", "help.", "brush.presets."];
+    const IDS: &[&str] = &[
+        "file.new",
+        "file.close",
+        "file.closeAll",
+        "edit.preferences",
+        "edit.colorSettings",
+        "edit.keyboardShortcuts",
+        "edit.menus",
+        "gradient.presets.edit",
+        "gradient.presets.importGrd",
+        "gradient.presets.new",
+        "gradient.presets.reset",
+        "gradient.presets.select",
+        "gradient.presets.stop",
+    ];
     PREFIXES.iter().any(|p| id.starts_with(p)) || IDS.contains(&id)
 }
 
