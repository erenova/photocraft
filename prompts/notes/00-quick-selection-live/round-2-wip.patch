+fn a_stroke_too_costly_for_its_brush_is_refused_before_any_work() {
+    assert_eq!(max_segments(30.0), MAX_SEGMENTS);
+    assert_eq!(max_segments(f32::NAN), MAX_SEGMENTS);
+    let at_300 = max_segments(300.0);
+    assert!((300..=400).contains(&at_300), "{at_300}");
+    assert_eq!(max_segments(5000.0), 1);
+    assert_eq!(max_segments(1e9), 1);
+    assert_eq!(max_segments(-4.0), MAX_SEGMENTS);
+    // A live cut stops at the cap: the rest is the last segment.
+    let mut c = Cutter::new(5000.0);
+    for i in 0..100 {
+        c.push((i as f32 * 900.0, 0.0), SelectionMode::Add);
+    }
+    c.finish();
+    assert_eq!(c.closed(), &[(100, SelectionMode::Add)]);
+    // A scripted stroke over the cap is refused at once, with the reason.
+    let mut s = two_regions(8);
+    let cap = max_segments(3000.0);
+    let stroke = |n: usize| {
+        let pts: Vec<[f64; 2]> = (0..n).map(|i| [(i * 20 % 140) as f64, 50.0]).collect();
+        json!({"points": pts, "segments": vec![1; n], "size": 3000})
+    };
+    let t = std::time::Instant::now();
+    let err = s.execute("select.quick", stroke(cap + 1)).unwrap_err();
+    assert!(matches!(&err, EngineError::BadParams { msg, .. } if msg.contains("at most")), "{err}");
+    assert!(t.elapsed() < std::time::Duration::from_secs(2), "refused before growing anything");
+    assert!(s.execute("select.quick", stroke(cap)).is_ok());
+    let err = s.execute("select.quick", json!({"points": vec![[10.0, 10.0]; MAX_POINTS + 1]})).unwrap_err();
+    assert!(matches!(&err, EngineError::BadParams { msg, .. } if msg.contains("at most")), "{err}");
