+/// Grow the stroke of `pts` cut as `segments` onto `stroke`: as many segments' regions at a time
+/// as there are threads, combined in order, checking `ctx` (cancellation, progress) between them.
+pub fn grow_segments(src: &QuickSource, stroke: &mut QuickStroke, pts: &[(f32, f32)], segments: &[(usize, SelectionMode)], ctx: &JobCtx) -> Result<()> {
+    let mut planned = Vec::with_capacity(segments.len());
+    let mut at = 0usize;
+    for &(n, m) in segments {
+        let end = at.saturating_add(n).min(pts.len());
+        planned.push(stroke.plan(src, pts.get(at..end).unwrap_or_default(), m));
+        at = end;
+    }
+    let total = planned.len().max(1) as f32;
+    let mut done = 0usize;
+    for group in planned.chunks(threads()) {
+        ctx.check()?;
+        ctx.progress(done as f32 / total, "Selecting");
+        for (p, region) in group.iter().zip(grow_regions(src, group)) {
+            let mode = p.as_ref().map_or(SelectionMode::Add, |p| p.mode);
+            if p.is_some() {
+                stroke.apply(mode, region);
+            }
+        }
+        done += group.len();
+    }
+    Ok(())
+}
