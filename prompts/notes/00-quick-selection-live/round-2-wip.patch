+fn a_stroke_still_growing_commits_as_a_job_on_its_own_document() {
+    for depth in [8, 16, 32] {
+        let mut s = two_regions(depth);
+        let gate = Arc::new(std::sync::atomic::AtomicBool::new(false));
+        let (offer, params) = growing_offer(&s, &gate);
+        s.offer_live_quick(offer);
+        let crate::jobs::Started::Job(job) = s.start("select.quick", params.clone()).unwrap() else { panic!("depth {depth}: a job") };
+        // Its document is locked like for any job: an edit is refused with the job's name.
+        let err = s.execute("select.all", json!({})).unwrap_err();
+        assert!(err.to_string().contains("Quick Selection") && err.to_string().contains("still running"), "{err}");
+        // Another document becomes the active one meanwhile: the stroke still lands on its own.
+        s.execute("file.new", json!({"width": 16, "height": 16})).unwrap();
+        gate.store(true, std::sync::atomic::Ordering::Relaxed);
+        let r = s.wait_job(job).unwrap();
+        assert_eq!(r["fromLive"], true, "depth {depth}: {r}");
+        assert_eq!(s.active_index(), Some(1), "the active document stays the new one");
+        assert!(s.documents()[1].doc.selection.is_none());
+        s.set_active(0);
+        let (id, journaled) = s.journal.iter().rev().find(|(id, _)| id == "select.quick").unwrap().clone();
+        assert_eq!(id, "select.quick");
+        assert_eq!(sel_bytes(&s), replayed(depth, &[], &journaled), "depth {depth}: commit == replay");
+        assert_eq!(s.active().unwrap().history.undo_label(), Some("Quick Selection"));
+    }
