+#[test]
+fn a_failure_on_a_base_the_stroke_has_left_is_ignored() {
+    // Review of #9145: a worker failing on the old base marked the rebased stroke failed.
+    let mut app = quick_app();
+    let src = QuickSource::new(&app.session, &settings(&app)).unwrap();
+    let mut live = QuickLive::new(app.session.active().unwrap().doc.id, settings(&app));
+    live.start(src.clone());
+    live.start(src);
+    assert_eq!(live.generation, 1);
+    let (worker, back) = Worker::detached();
+    live.worker = Some(worker);
+    back.send(Back::Failed { generation: 0 }).unwrap();
+    assert!(matches!(live.collect(false), Ok(None)), "the old base's failure is dropped");
+    back.send(Back::Failed { generation: 1 }).unwrap();
+    assert!(live.collect(false).is_err(), "the current base's ends the stroke");
+    app.quick.strokes.clear();
+}
